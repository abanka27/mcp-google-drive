{
  "name": "@abanka27/mcp-google-drive",
  "version": "0.1.0",
  "description": "MCP server and CLI for interacting with Google Drive",
  "license": "MIT",
  "author": "Anshuman Banka",
  "homepage": "https://github.com/abanka27/mcp-google-drive",
  "bugs": "https://github.com/abanka27/mcp-google-drive/issues",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abanka27/mcp-google-drive.git"
  },
  "keywords": [
    "Google Drive",
    "Google Sheets",
    "MCP",
    "Model Context Protocol",
    "AI"
  ],
  "bin": {
    "mcp-google-drive": "dist/index.js",
    "gdrive": "dist/bin/gdrive.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "google-auth-library": "^10.7.0"
  },
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js dist/bin/gdrive.js",
    "prepare": "npm run build",
    "setup": "npm run build && node dist/bin/gdrive.js setup",
    "watch": "tsc --watch",
    "bench:tools": "npm run build && node dist/scripts/benchmark-tools.js"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  }
}
